#!/bin/bash
# Privileged helper: set the Acer platform profile. Only accepts the four
# known profiles so it is safe to expose via a NOPASSWD sudoers rule.
p="$1"
case "$p" in
    quiet|balanced|balanced-performance|performance)
        echo "$p" > /sys/firmware/acpi/platform_profile
        ;;
    *)
        echo "invalid profile: $p (expected quiet|balanced|balanced-performance|performance)" >&2
        exit 1
        ;;
esac
